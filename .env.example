# Inbox for /courses waitlist (FormSubmit). First submit sends a confirm link to this address.
VITE_WAITLIST_EMAIL=you@yourdomain.com

# Auth (Supabase). Leave empty to use local browser-only accounts for development.
# Project → Settings → API → Project URL + anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
