# Inbox for /courses waitlist (FormSubmit). First submit sends a confirm link to this address.
VITE_WAITLIST_EMAIL=you@yourdomain.com

# Auth + payments (Supabase). Project Settings → API → Project URL + anon/publishable key
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# PostHog (product analytics). Project settings → Project token & ID (public token, not secret).
# Host: https://eu.i.posthog.com (EU) or https://us.i.posthog.com (US)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Never put NOWPAYMENTS_* keys or PostHog *secret* keys here.
